# 确定性演示模式：不需要 API key。
MEETING_ASSISTANT_MODE=demo
MEETING_ASSISTANT_DATABASE_PATH=meetings.db

# 使用真实结构化输出模型时，将 MEETING_ASSISTANT_MODE 设为 llm，
# 并在终端环境或密钥管理工具中提供 MEETING_ASSISTANT_LLM_API_KEY。
# 不要把真实密钥写入或提交到本文件。
MEETING_ASSISTANT_LLM_MODEL=gpt-4.1-mini
# DeepSeek V4 示例：
# MEETING_ASSISTANT_LLM_MODEL=deepseek-v4-flash
# MEETING_ASSISTANT_LLM_BASE_URL=https://api.deepseek.com
# 其他 OpenAI 兼容服务可填写自己的模型名和接口地址。
# MEETING_ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
