# Deterministic default: no API key is needed.
MEETING_ASSISTANT_MODE=demo
MEETING_ASSISTANT_DATABASE_PATH=meetings.db

# To use a real structured-output model, set MEETING_ASSISTANT_MODE=llm and
# provide MEETING_ASSISTANT_LLM_API_KEY in your shell or secret manager.
# Never commit a real key to this file.
MEETING_ASSISTANT_LLM_MODEL=gpt-4.1-mini
# MEETING_ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
